# Notion integration secret (서버 전용, 필수). NEXT_PUBLIC_ 접두사를 붙이거나
# 클라이언트 컴포넌트/브라우저 번들, 로그, 커밋에 절대 노출하지 않는다.
NOTION_API_KEY=secret_your_notion_integration_key

# 견적서(invoices) 데이터베이스 ID (서버 전용, 필수).
NOTION_DATABASE_ID=your_notion_database_id

# 관리자 화면(/admin/*) 접근용 고정 비밀번호 (서버 전용, 필수, D-V1-01 확정).
# 코드에 하드코딩하지 않는다. 클라이언트 번들·로그·커밋에 노출 금지.
ADMIN_PASSWORD=change_this_password

# 관리자 세션 쿠키 서명에 사용하는 HMAC 비밀키 (서버 전용, 필수, D-V1-01 확정).
# 무작위의 긴 문자열로 설정한다(예: openssl rand -base64 32). 값이 유출되면
# 누구나 유효한 관리자 세션 쿠키를 위조할 수 있으므로 ADMIN_PASSWORD와 동일한
# 수준으로 보호한다.
ADMIN_SESSION_SECRET=change_this_to_a_random_long_string

# 배포 환경(개발/스테이징/운영) 값 주입은 Vercel 프로젝트 콘솔에서 관리한다
# (D-13 확정: Vercel 후보). Project Settings > Environment Variables에서
# Preview/Production 환경별로 값을 분리 설정하며, 이 파일은 로컬 개발용
# 단일 값 예시로만 유지한다.
